rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      // Owner may update their own doc, but NOT their tier/entitlements —
      // those are set server-side (billing/admin), never self-granted.
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['tier', 'entitlements']);

      // Image builds: owner can read their own; only the server (firebase-admin,
      // which bypasses rules) creates/updates them. Clients never write builds.
      match /builds/{buildId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Intake is server-written only; client access denied.
    match /lead_intake/{leadId} {
      allow read, write: if false;
    }

    match /notification_outbox/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
