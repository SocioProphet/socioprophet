PORT=

# Socbase (Supabase) — replaces FIREBASE_PROJECT_ID. Service-role key is
# server-only: it bypasses RLS and must never reach the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GCS bucket for build artifacts (unchanged by the Socbase migration — still
# plain Google Cloud Storage, just no longer accessed via firebase-admin).
SOURCEOS_GCS_BUCKET=
# GCP creds for the storage/compute calls now come from google-auth-library's
# Application Default Credentials — set GOOGLE_APPLICATION_CREDENTIALS to a
# service-account JSON path locally, or rely on ambient creds in prod.
GOOGLE_APPLICATION_CREDENTIALS=
