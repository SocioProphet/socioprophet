# SocioProphet Vue app shell environment template.
# Copy to `.env.local` for local development.

# App route base. Use `/` unless the app shell is served from a subpath.
VITE_ROUTER_BASE=/

# GAIA / OpenStreetMap API base.
# Option A: same-origin Vite proxy. This is the default for local shell work.
VITE_GAIA_MAP_API_BASE=/api

# Option B: direct local API. Requires OSM_MAP_API_CORS_ALLOWED_ORIGINS=http://localhost:5174 on the API.
# VITE_GAIA_MAP_API_BASE=http://127.0.0.1:8088
