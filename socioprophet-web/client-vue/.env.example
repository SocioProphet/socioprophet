# SocioProphet Vue app shell environment template.
# Copy to `.env.local` for local development.

# App route base. Use `/` unless the app shell is served from a subpath.
VITE_ROUTER_BASE=/

# GAIA / OpenStreetMap API base URL.
#
# Option A (default): same-origin Vite proxy.
#   vite.config.ts proxies /api → VITE_API_BASE (default: http://localhost:8088).
#   Run the OSM Map API separately from SocioProphet/prophet-platform.
VITE_GAIA_MAP_API_BASE=/api

# Option B: direct local API.
#   Requires OSM_MAP_API_CORS_ALLOWED_ORIGINS=http://localhost:5174 on the API.
# VITE_GAIA_MAP_API_BASE=http://127.0.0.1:8088

# Option C: staging / preview deployment.
#   Point at your staging API host. Must allow the preview app origin in CORS.
# VITE_GAIA_MAP_API_BASE=https://api-staging.example.com

# Backend API proxy target (used only when VITE_GAIA_MAP_API_BASE=/api).
# Ignored when VITE_GAIA_MAP_API_BASE is a full URL.
# VITE_API_BASE=http://localhost:8088
