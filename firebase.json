{
  "hosting": [
    {
      "target": "docs",
      "public": "docs/.vitepress/publish",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false
    },
    {
      "target": "marketing",
      "public": "marketing/public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/lead",
          "function": "leadCapture"
        }
      ]
    },
    {
      "target": "app",
      "public": "socioprophet-web/app-vue/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "run": { "serviceId": "builder-api", "region": "us-central1" }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": {
    "source": "functions"
  }
}
